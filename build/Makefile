.PHONY : src/util/utf8.obj

# target to build an object file
src/util/utf8.cc.obj:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\main.exe.dir\build.make CMakeFiles/main.exe.dir/src/util/utf8.cc.obj
.PHONY : src/util/utf8.cc.obj

src/util/utf8.i: src/util/utf8.cc.i
.PHONY : src/util/utf8.i

# target to preprocess a source file
src/util/utf8.cc.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\main.exe.dir\build.make CMakeFiles/main.exe.dir/src/util/utf8.cc.i
.PHONY : src/util/utf8.cc.i

src/util/utf8.s: src/util/utf8.cc.s
.PHONY : src/util/utf8.s

# target to generate assembly for a file
src/util/utf8.cc.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\main.exe.dir\build.make CMakeFiles/main.exe.dir/src/util/utf8.cc.s
.PHONY : src/util/utf8.cc.s

